# Loaded by uvicorn --env-file .env. Preserve any existing unrelated variables.
LOA_DB=loa.sqlite3
LOA_AUTH_MODE=supabase
LOA_SIMULATOR=false
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=loa-backend
MQTT_PASSWORD=YOUR_BACKEND_BROKER_PASSWORD
MQTT_TLS=false
# For an isolated local demo only: LOA_AUTH_MODE=demo and LOA_SIMULATOR=true
# Exact frontend origin allowed to call a separate backend (no trailing slash).
LOA_WEB_ORIGINS=

# Enable after applying supabase/migrations/202611150001_incident_reports.sql.
LOA_REPORT_STORE=sqlite
